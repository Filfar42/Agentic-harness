+    "name": "read_file", "arguments": {"filepath": "a.txt"},
+}}]}}
+OPENAI_CALL = choice({"tool_calls": [{"index": 0, "id": "call_a", "function": {
+    "name": "read_file", "arguments": '{"filepath":"a.txt"}',
+}}]})
