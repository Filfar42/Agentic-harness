diff --git a/web/passi.css b/web/passi.css
new file mode 100644
index 0000000..f9e1e94
--- /dev/null
+++ b/web/passi.css
@@ -0,0 +1,207 @@
+/* I passi del lavoro dell'agente (web/passi.js), desktop e telefono.
+ *
+ * Niente riquadri: prima ogni pensiero e ogni tool era una scatola con bordo,
+ * fondo e raggio, ~43 px l'una, tutte uguali. Un turno da sette tool erano
+ * undici scatole prima della risposta. Qui un passo e' una riga, i passi di un
+ * tratto di lavoro stanno su una rotaia sottile, e a lavoro finito il tratto
+ * intero e' una riga sola.
+ *
+ * I colori arrivano dalle variabili --ps-*, che ogni client definisce con i
+ * suoi token (web/style.css, web_mobile/style.css): la geometria e' una, i
+ * valori sono di chi la ospita. */
+
+.ps-gruppo {
+  margin: 4px 0 10px;
+  font-size: var(--ps-font, 13px);
+}
+
+/* ---------- intestazione del blocco ---------- */
+
+.ps-testa {
+  display: flex; align-items: center; gap: 9px;
+  width: calc(100% + 16px); min-height: var(--ps-riga-h, 28px);
+  margin: 0 -8px; padding: 0 8px; border: 0; border-radius: 7px;
+  background: none; color: var(--ps-medio); font: inherit; text-align: left;
+  cursor: pointer; white-space: nowrap;
+}
+.ps-gruppo.vivo > .ps-testa { cursor: default; color: var(--ps-testo); }
+.ps-gruppo:not(.vivo) > .ps-testa:hover { background: var(--ps-hover); }
+.ps-titolo { flex: none; }
+.ps-meta-gruppo {
+  min-width: 0; overflow: hidden; text-overflow: ellipsis;
+  color: var(--ps-tenue); font-variant-numeric: tabular-nums;
+}
+.ps-chev { color: var(--ps-tenue); transition: transform 180ms ease-out; }
+.ps-gruppo.aperto > .ps-testa .ps-chev { transform: rotate(90deg); }
+
+.ps-pill {
+  flex: none; margin-left: auto; display: inline-flex; align-items: center;
+  height: 20px; padding: 0 8px; border-radius: 999px;
+  font-size: 11.5px; font-weight: 500; border: 1px solid transparent;
+}
+.ps-pill-lungo { white-space: pre; }
+.ps-pill::before { content: ""; width: 6px; height: 6px; margin-right: 5px; border-radius: 50%; background: currentColor; }
+.ps-pill.ok { color: var(--ps-ok); border-color: color-mix(in srgb, var(--ps-ok) 35%, transparent); }
+.ps-pill.err { color: var(--ps-err); border-color: color-mix(in srgb, var(--ps-err) 40%, transparent); }
+
+/* ---------- la traccia: rotaia e passi ---------- */
+
+.ps-traccia { position: relative; }
+.ps-traccia[hidden] { display: none; }
+/* La rotaia passa sotto le icone, che hanno il fondo della pagina: si vede
+   fra una e l'altra, non attraverso. Stesso asse dell'icona dell'intestazione,
+   cosi' il blocco aperto scende dalla sua freccia. */
+.ps-traccia::before {
+  content: ""; position: absolute; left: 7.5px; top: 4px; bottom: 10px;
+  width: 1px; background: var(--ps-bordo);
+}
+.ps-passo[hidden], .ps-piega[hidden] { display: none; }
+
+.ps-riga, .ps-piega {
+  position: relative;
+  display: flex; align-items: center; gap: 9px;
+  width: calc(100% + 16px); min-height: var(--ps-riga-h, 28px);
+  margin: 0 -8px; padding: 0 8px; border: 0; border-radius: 7px;
+  background: none; color: var(--ps-medio); font: inherit; text-align: left;
+  cursor: pointer; white-space: nowrap;
+}
+.ps-riga:hover, .ps-piega:hover { background: var(--ps-hover); }
+.ps-piega { color: var(--ps-tenue); font-size: 0.95em; }
+.ps-piega:hover { color: var(--ps-accento); }
+.ps-passo.vivo > .ps-riga, .ps-passo.corso > .ps-riga { cursor: default; color: var(--ps-testo); }
+.ps-passo.vivo > .ps-riga:hover, .ps-passo.corso > .ps-riga:hover { background: none; }
+
+.ps-ico {
+  position: relative; z-index: 1;
+  flex: none; width: 16px; height: 16px; display: grid; place-items: center;
+  border-radius: 50%; background: var(--ps-fondo); color: var(--ps-tenue);
+}
+.ps-riga:hover .ps-ico, .ps-piega:hover .ps-ico, .ps-testa:hover .ps-ico { background: var(--ps-hover); }
+.ps-ico svg { display: block; }
+.ps-ico.err { color: var(--ps-err); }
+.ps-ico.gira svg { color: var(--ps-accento); animation: ps-gira 2.6s linear infinite; }
+.ps-ruota {
+  width: 11px; height: 11px; border-radius: 50%;
+  border: 1.6px solid var(--ps-bordo-forte); border-top-color: var(--ps-accento);
+  animation: ps-gira .7s linear infinite;
+}
+@keyframes ps-gira { to { transform: rotate(360deg); } }
+
+.ps-verbo { flex: none; }
+.ps-oggetto {
+  min-width: 0; overflow: hidden; text-overflow: ellipsis;
+  font-family: var(--ps-mono); font-size: 0.96em; color: var(--ps-testo);
+}
+.ps-estratto {
+  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis;
+  font-style: italic; color: var(--ps-tenue);
+}
+.ps-meta {
+  flex: none; margin-left: auto; padding-left: 8px;
+  font-size: 0.92em; color: var(--ps-tenue); font-variant-numeric: tabular-nums;
+  display: inline-flex; gap: 5px;
+}
+.ps-meta.ok { color: var(--ps-ok); }
+.ps-meta.err { color: var(--ps-err); }
+.ps-piu { color: var(--ps-ok); }
+.ps-meno { color: var(--ps-err); }
+
+/* ---------- il pensiero dal vivo: quattro righe, non di piu' ---------- */
+
+/* L'altezza e' fissa e il testo sta in fondo: le righe nuove spingono su le
+   vecchie, che sfumano. Il pensiero intero resta leggibile aprendo la riga a
+   passo chiuso. Prima la tendina restava aperta fino a fine turno, una per
+   passo, con tutto il testo: era questo a invadere la chat. */
+.ps-finestra {
+  margin: 0 0 6px 7.5px; padding-left: 16px;
+  border-left: 1px solid var(--ps-accento);
+  height: calc(4 * 1.6em); overflow: hidden;
+  display: flex; flex-direction: column; justify-content: flex-end;
+  font-size: 0.96em; line-height: 1.6; color: var(--ps-medio);
+  -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 55%);
+  mask-image: linear-gradient(to bottom, transparent 0, #000 55%);
+}
+.ps-finestra-testo { white-space: pre-wrap; word-break: break-word; }
+
+/* ---------- il dettaglio di un passo ---------- */
+
+.ps-corpo { margin: 2px 0 8px 25px; }
+.ps-corpo[hidden] { display: none; }
+.ps-pensiero-testo {
+  font-size: 0.98em; line-height: 1.6; color: var(--ps-medio);
+  border-left: 1px solid var(--ps-bordo-forte); padding: 2px 0 2px 12px;
+  white-space: pre-wrap; word-break: break-word;
+}
+
+.ps-code {
+  border: 1px solid var(--ps-bordo); border-radius: 8px;
+  background: var(--ps-code-bg); overflow: hidden;
+}
+.ps-code-testa {
+  display: flex; align-items: center; gap: 8px; padding: 4px 10px;
+  border-bottom: 1px solid var(--ps-bordo);
+  font-family: var(--ps-mono); font-size: 11.5px; color: var(--ps-tenue);
+  white-space: nowrap;
+}
+.ps-code-titolo { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.ps-exit { margin-left: auto; flex: none; }
+.ps-exit.ok { color: var(--ps-ok); }
+.ps-exit.err { color: var(--ps-err); }
+.ps-code-corpo {
+  max-height: 260px; overflow: auto; padding: 4px 0;
+  font-family: var(--ps-mono); font-size: 11.5px; line-height: 1.6;
+}
+.ps-ln { display: flex; width: max-content; min-width: 100%; }
+.ps-ln.piu { background: var(--ps-piu-bg); }
+.ps-ln.meno { background: var(--ps-meno-bg); }
+.ps-ln.contesto .ps-t { color: var(--ps-medio); }
+.ps-ln.nota .ps-t { color: var(--ps-tenue); font-style: italic; }
+.ps-n {
+  flex: none; width: 46px; padding-right: 10px; text-align: right;
+  color: var(--ps-tenue); user-select: none;
+}
+.ps-sg { flex: none; width: 14px; text-align: center; user-select: none; }
+.ps-ln.piu .ps-sg { color: var(--ps-ok); }
+.ps-ln.meno .ps-sg { color: var(--ps-err); }
+.ps-t { white-space: pre; padding: 0 10px 0 2px; color: var(--ps-testo); }
+.ps-ln-file { padding: 4px 10px 1px; color: var(--ps-tenue); }
+.ps-ln-file:not(:first-child) { margin-top: 4px; }
+.ps-hit { background: none; color: var(--ps-accento); font-weight: 600; }
+
+.ps-term { display: flex; flex-direction: column-reverse; }
+.ps-term-testo {
+  margin: 0; padding: 2px 10px; white-space: pre; color: var(--ps-testo);
+  font: inherit;
+}
+
+.ps-errore {
+  padding: 6px 10px; border-radius: 8px;
+  background: color-mix(in srgb, var(--ps-err) 8%, transparent);
+  color: var(--ps-err); line-height: 1.5; white-space: pre-wrap; word-break: break-word;
+}
+.ps-errore-nota { color: var(--ps-medio); margin-top: 3px; }
+
+.ps-campi { display: flex; flex-direction: column; gap: 3px; line-height: 1.5; }
+.ps-campo { display: flex; gap: 10px; }
+.ps-k { flex: none; min-width: 88px; color: var(--ps-tenue); font-family: var(--ps-mono); font-size: 11.5px; padding-top: 1px; }
+.ps-v { min-width: 0; white-space: pre-wrap; word-break: break-word; color: var(--ps-testo); }
+
+.ps-nota { margin-top: 4px; font-size: 11.5px; color: var(--ps-tenue); }
+.ps-piede { display: flex; justify-content: flex-end; margin-top: 4px; }
+.ps-grezzo {
+  border: 0; background: none; padding: 2px 0; cursor: pointer; font: inherit;
+  font-size: 11.5px; color: var(--ps-tenue);
+  text-decoration: underline dotted; text-underline-offset: 3px;
+}
+.ps-grezzo:hover { color: var(--ps-accento); }
+.ps-grezzo-testo {
+  margin: 4px 0 0; padding: 6px 10px; max-height: 220px; overflow: auto;
+  border: 1px solid var(--ps-bordo); border-radius: 8px; background: var(--ps-code-bg);
+  font-family: var(--ps-mono); font-size: 11px; line-height: 1.5; color: var(--ps-medio);
+  white-space: pre-wrap; word-break: break-word;
+}
+.ps-grezzo-testo[hidden] { display: none; }
+
+@media (prefers-reduced-motion: reduce) {
+  .ps-ico.gira svg, .ps-ruota { animation: none; }
+}
diff --git a/web/passi.js b/web/passi.js
new file mode 100644
index 0000000..25c5001
--- /dev/null
+++ b/web/passi.js
@@ -0,0 +1,1050 @@
+/* I passi del lavoro dell'agente: come si leggono in chat.
+ *
+ * Un passo e' un pensiero o una chiamata a tool. In chat non stanno piu' uno
+ * per riquadro: stanno in un **blocco di lavoro**, una riga sola a lavoro
+ * finito ("Ha lavorato 41 s · 2 letture · 1 modifica · 2 comandi") che si apre
+ * in una traccia con una riga per passo, e ogni riga si apre sul suo dettaglio
+ * gia' letto per tipo -- l'estratto con i numeri di riga, il diff, il
+ * terminale -- con il JSON grezzo a un clic.
+ *
+ * Perche' un file a parte, condiviso da desktop e telefono: prima i due client
+ * avevano due idee di "com'e' fatto un passo" (il desktop una tendina col nome
+ * del tool e il JSON, il telefono una riga col verbo e basta), e ogni tool
+ * nuovo andava insegnato due volte. Qui c'e' una copia sola. Il desktop lo
+ * carica da /static/passi.js, il telefono da /comune/passi.js (server/mobile.py).
+ *
+ * Due strati, separati apposta:
+ *   - funzioni **pure** (``riga``, ``vista``, ``riassunto``, ``frase``...):
+ *     dal risultato di un tool ricavano dati, non nodi. Le prova la suite in
+ *     QuickJS (tests/test_passi_web.py) senza un browser;
+ *   - costruttori di nodi (``passoTool``, ``passoPensiero``, ``gruppo``): solo
+ *     ``createElement`` e ``textContent`` per tutto quello che viene dal
+ *     modello o dai file. ``innerHTML`` si usa solo per le icone, che sono
+ *     costanti di questo file.
+ *
+ * Il dettaglio di un passo si costruisce **al primo clic**, come faceva la
+ * tendina del desktop dalla v2.36: un ``write_file`` da 34 kB non entra nel DOM
+ * per non essere guardato.
+ */
+(function (radice) {
+  'use strict';
+
+  // -------------------------------------------------------------------------
+  // Icone: tratto a 16 px, colore dal testo. Costanti, mai dati del modello.
+  // -------------------------------------------------------------------------
+
+  const S = '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" '
+    + 'stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">';
+  const ICONE = {
+    pensiero: S + '<circle cx="8" cy="8" r="5.5" stroke-dasharray="2.2 2.2"/></svg>',
+    leggi: S + '<path d="M4 1.75h5.25L12.5 5v9.25H4z"/><path d="M9 1.75V5.25h3.5"/></svg>',
+    scrivi: S + '<path d="M4 1.75h5.25L12.5 5v9.25H4z"/><path d="M8.25 7.5v4M6.25 9.5h4"/></svg>',
+    modifica: S + '<path d="M10.6 2.4l3 3-8 8H2.6v-3z"/></svg>',
+    cerca: S + '<circle cx="7" cy="7" r="4.25"/><path d="M10.2 10.2l3.3 3.3"/></svg>',
+    esegui: S + '<path d="M2.5 4l4 4-4 4"/><path d="M8 12.5h5.5"/></svg>',
+    elenca: S + '<path d="M3 4h10M3 8h10M3 12h6"/></svg>',
+    piano: S + '<path d="M2.5 4.2l1.3 1.3 2.2-2.4M2.5 10.7l1.3 1.3 2.2-2.4M8 4.5h5.5M8 11h5.5"/></svg>',
+    note: S + '<path d="M3.5 2h9v12h-9z"/><path d="M6 5.5h4M6 8h4M6 10.5h2.5"/></svg>',
+    memoria: S + '<path d="M8 2.2l1.6 3.3 3.6.5-2.6 2.5.6 3.6L8 10.4l-3.2 1.7.6-3.6-2.6-2.5 3.6-.5z"/></svg>',
+    web: S + '<circle cx="8" cy="8" r="5.8"/><path d="M2.2 8h11.6M8 2.2c1.8 1.7 2.6 3.7 2.6 5.8S9.8 12.1 8 13.8C6.2 12.1 5.4 10.1 5.4 8S6.2 3.9 8 2.2z"/></svg>',
+    anteprima: S + '<rect x="2" y="3" width="12" height="9" rx="1.2"/><path d="M5.5 14h5"/></svg>',
+    esplora: S + '<circle cx="8" cy="8" r="5.8"/><path d="M10.4 5.6l-1.4 3.4-3.4 1.4 1.4-3.4z"/></svg>',
+    domanda: S + '<circle cx="8" cy="8" r="5.8"/><path d="M6.3 6.3a1.8 1.8 0 1 1 2.4 1.7c-.5.2-.7.6-.7 1.1v.4M8 11.4v.1"/></svg>',
+    altro: S + '<circle cx="8" cy="8" r="1.2"/><circle cx="3.8" cy="8" r="1.2"/><circle cx="12.2" cy="8" r="1.2"/></svg>',
+    chev: '<svg viewBox="0 0 10 10" width="10" height="10" fill="none" stroke="currentColor" '
+      + 'stroke-width="1.6" aria-hidden="true"><path d="M3.5 1.5L7 5l-3.5 3.5"/></svg>',
+  };
+
+  // -------------------------------------------------------------------------
+  // Piccoli attrezzi di testo
+  // -------------------------------------------------------------------------
+
+  function tronca(valore, quanti) {
+    const testo = String(valore ?? '').replace(/\s+/g, ' ').trim();
+    if (testo.length <= quanti) return testo;
+    // trimEnd prima dei puntini: "configura il …" sembra un errore di stampa.
+    return `${testo.slice(0, quanti - 1).trimEnd()}…`;
+  }
+
+  function nomeFile(percorso) {
+    const pulito = String(percorso ?? '').replace(/[\\/]+$/, '');
+    const pezzi = pulito.split(/[\\/]/);
+    return pezzi[pezzi.length - 1] || pulito || '?';
+  }
+
+  /** Il risultato di un tool come oggetto: arriva come stringa JSON dal
+   *  server, ma un risultato non-JSON e' solo testo e non un errore. */
+  function analizza(risultato) {
+    if (risultato && typeof risultato === 'object') return risultato;
+    try {
+      const dati = JSON.parse(String(risultato ?? ''));
+      return dati && typeof dati === 'object' && !Array.isArray(dati) ? dati : null;
+    } catch (_) {
+      return null;
+    }
+  }
+
+  /** Durata leggibile, alla italiana: "0,4 s", "3,4 s", "41 s", "2 min 5 s".
+   *  Sotto il decimo di secondo non dice niente a nessuno: stringa vuota. */
+  function durata(secondi) {
+    const s = Number(secondi);
+    if (!Number.isFinite(s) || s < 0.1) return '';
+    if (s < 10) return `${s.toFixed(1).replace('.', ',')} s`;
+    if (s < 60) return `${Math.round(s)} s`;
+    const tot = Math.round(s);
+    return `${Math.floor(tot / 60)} min ${tot % 60} s`;
+  }
+
+  function plurale(n, uno, tanti) {
+    return `${n} ${n === 1 ? uno : tanti}`;
+  }
+
+  /** L'inizio di un pensiero, per la riga chiusa: la prima frase, al massimo
+   *  una riga di testo. Chi vuole il resto apre. */
+  function estratto(testo) {
+    const pulito = String(testo ?? '').replace(/\s+/g, ' ').trim();
+    const frase = pulito.match(/^.{20,}?[.!?](?=\s|$)/);
+    return tronca(frase ? frase[0] : pulito, 160);
+  }
+
+  // -------------------------------------------------------------------------
+  // I tool: icona, verbo, oggetto
+  // -------------------------------------------------------------------------
+
+  const cartella = (a) => (a.subfolder && a.subfolder !== '.' ? ` in ${String(a.subfolder).replace(/\/+$/, '')}/` : '');
+
+  // Il verbo prima dell'oggetto: "Legge tools.py" si capisce in mezzo secondo,
+  // `read_file {"filepath": "core/tools.py"}` no. Del percorso resta il nome
+  // del file (il percorso intero e' il titolo della riga): *cosa*, non *dove*.
