+/* A decorative 28 px presence. The existing logo slot owns its dimensions. */
+.harness-companion-host {
+  display: grid;
+  place-items: center;
+}
+
+.harness-companion {
+  --companion-face: #1c2b30;
+  --companion-eye: #ffffff;
+  --companion-active: #0b7169;
+  display: block;
+  width: 28px;
+  height: 28px;
+  overflow: visible;
+  color: var(--companion-face);
+  pointer-events: none;
+  user-select: none;
+}
+
+html[data-theme="dark"] .harness-companion {
+  --companion-face: #edf3f3;
+  --companion-eye: #11181b;
+  --companion-active: #68d5c4;
+}
+
+.harness-companion__pose {
+  transform-origin: 16px 19px;
+}
+
+.harness-companion__eyes {
+  fill: var(--companion-eye);
+  transform-origin: 16px 18px;
+}
+
+.harness-companion[data-state="working"] {
+  color: var(--companion-active);
+}
+
+.harness-companion[data-state="resting"] .harness-companion__eyes {
+  transform: translateX(1px);
+}
+
+.harness-companion[data-gesture="greet"] .harness-companion__pose {
+  animation: companion-greet 240ms ease-out 1;
+}
+
+.harness-companion[data-gesture="nod"] .harness-companion__pose {
+  animation: companion-nod 240ms ease-in-out 1;
+}
+
+.harness-companion[data-gesture="look"] .harness-companion__eyes {
+  animation: companion-look 240ms ease-in-out 1;
+}
+
+.harness-companion[data-gesture="blink"] .harness-companion__eyes {
+  animation: companion-blink 240ms ease-in-out 1;
+}
+
+@keyframes companion-greet {
+  0%, 100% { transform: rotate(0deg); }
+  48% { transform: rotate(-4deg); }
+}
+
+@keyframes companion-nod {
+  0%, 100% { transform: translateY(0); }
+  50% { transform: translateY(1.2px); }
+}
+
+@keyframes companion-look {
+  0%, 100% { transform: translateX(0); }
+  45% { transform: translateX(1px); }
+}
+
+@keyframes companion-blink {
+  0%, 100% { transform: translateX(1px); }
+  45% { transform: translateX(1px) scaleY(.12); }
+}
+
+.harness-companion[data-paused="true"] *,
+.harness-companion[data-reduced-motion="true"] * {
+  animation: none !important;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .harness-companion * { animation: none !important; }
+}
